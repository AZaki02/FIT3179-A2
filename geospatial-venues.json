{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Live Music Venues Locations, 2025",
  "width": 200,
  "height": 250,
  "background": "#858585",
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/AZaki02/FIT3179-A2/refs/heads/main/ne_2.topojson.txt",
        "format": {
          "type": "topojson",
          "feature": "vic_localities",
          "mesh": "true"
        }
      },
      "projection": {
        "type": "mercator"
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "https://raw.githubusercontent.com/AZaki02/FIT3179-A2/refs/heads/main/live-music-venues.csv"
      },
      "transform": [
        {
          "filter": "datum.space_type != ''"
        }
      ],
      "mark": {
        "type": "circle",
        "radius": 1.5,
        "stroke": "black",
        "strokeWidth": 0.1
      },
      "params": [
        {
          "name": "space_type",
          "select": {
            "type": "point",
            "fields": [
              "space_type"
            ]
          },
          "bind": "legend"
        }
      ],
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "color": {
          "field": "space_type",
          "type": "nominal",
          "scale": {
            "scheme": "category20"
          },
          "legend": {
            "title": "Venue Type",
            "orient": "right",
            "symbolSize": 200,
            "symbolStrokeColor": "#111"
          }
        },
        "opacity": {
          "condition": {
            "param": "space_type",
            "value": 1
          },
          "value": 0.2
        },
        "tooltip": [
          {
            "field": "venue_name",
            "type": "nominal",
            "title": "Venue Name"
          },
          {
            "field": "space_type",
            "type": "nominal",
            "title": "Venue Type"
          },
          {
            "field": "suburb",
            "type": "nominal",
            "title": "Suburb"
          }
        ]
      }
    }
  ]
}